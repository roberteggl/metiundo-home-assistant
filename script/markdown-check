#!/bin/bash

# script/markdown-check: Check Markdown files for formatting and lint issues without making changes
#
# Runs mdformat in check-only mode and pymarkdownlint without auto-fix.
# No files are modified. Useful for CI/CD and targeted validation after Markdown changes.
#
# Usage:
#   ./script/markdown-check
#
# Examples:
#   ./script/markdown-check

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"

activate_venv

if ! command -v mdformat >/dev/null 2>&1 || ! command -v pymarkdown >/dev/null 2>&1; then
    die "Markdown tools not installed. Run: script/setup/bootstrap"
fi

run_hook "markdown-check" "pre"

log_header "Checking Markdown format (mdformat)"
mdformat --check ./*.md docs .github

log_header "Checking Markdown lint (pymarkdownlint)"
pymarkdown --config .pymarkdown scan -r ./*.md docs .github

run_hook "markdown-check" "post"
log_success "Markdown check completed"
