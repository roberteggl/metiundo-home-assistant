#!/bin/bash

# script/version: Display or validate the current integration version
#
# Reads the canonical version from manifest.json and can validate a release tag.
#
# Usage:
#   ./script/version [--tag|--check-tag TAG]
#
# Examples:
#   ./script/version                         # Print: 0.1.0
#   ./script/version --tag                   # Print: v0.1.0
#   ./script/version --check-tag v0.1.0     # Validate a tag matches manifest.json

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"
# shellcheck source=script/.lib/integration.sh
source "$SCRIPT_DIR/.lib/integration.sh"

MANIFEST="$INTEGRATION_PATH/manifest.json"

require_command jq "apt-get install jq"

get_version() {
    jq -r '.version' "$MANIFEST"
}

run_hook "version" "pre"

case "${1:-}" in
--tag)
    echo "v$(get_version)"
    ;;
--check-tag)
    if [[ $# -ne 2 ]]; then
        log_error "A release tag is required"
        echo "Usage: script/version --check-tag TAG"
        exit 1
    fi
    tag_version="${2#v}"
    manifest_version=$(get_version)
    if [[ "$2" == v* && "$tag_version" == "$manifest_version" ]]; then
        log_success "Tag and manifest versions match: $manifest_version"
    else
        log_error "Tag and manifest versions do not match"
        log_step "tag:                      $2"
        log_step "manifest.json:             $manifest_version"
        exit 1
    fi
    ;;
"")
    get_version
    ;;
*)
    log_error "Unknown option: $1"
    echo "Usage: script/version [--tag|--check-tag TAG]"
    exit 1
    ;;
esac

run_hook "version" "post"
