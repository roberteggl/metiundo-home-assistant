#!/bin/bash

# script/markdown: Format and lint Markdown files
#
# Runs mdformat (formatter) and pymarkdownlint (linter) with auto-fix enabled.
# Applies fixes where available; reports remaining issues in its output.
# Useful for targeted formatting and linting after Markdown changes.
#
# Usage:
#   ./script/markdown
#
# Examples:
#   ./script/markdown

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"

activate_venv

if ! command -v mdformat >/dev/null 2>&1 || ! command -v pymarkdown >/dev/null 2>&1; then
    die "Markdown tools not installed. Run: script/setup/bootstrap"
fi

run_hook "markdown" "pre"

log_header "Formatting Markdown with mdformat"
mdformat *.md docs .github

log_header "Linting Markdown with pymarkdownlint"
pymarkdown --config .pymarkdown fix -r *.md docs .github

run_hook "markdown" "post"
log_success "Markdown formatting completed"
